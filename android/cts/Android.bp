package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test_helper_app {
    name: "angle_end2end_tests_app",
    srcs: [
        "helper_app/**/*.java",
    ],
    manifest: "helper_app/AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "28",
    target_sdk_version: "33",
    jni_libs: [
        "libangle_end2end_tests__library",
        "libangle_util",
    ],
}
